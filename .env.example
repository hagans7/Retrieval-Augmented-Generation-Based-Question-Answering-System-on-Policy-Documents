# ============================================================
# legal — Environment Variables Reference
# Copy this file to .env and fill in all values.
# Never commit .env to version control.
# ============================================================

# APPLICATION
APP_NAME=legal
APP_VERSION=0.1.0
# Options: development | production
DEPLOYMENT_MODE=development
DEBUG=true
# UUID for static default user (used while auth is deferred)
# Generate with: python -c "import uuid; print(uuid.uuid4())"
DEFAULT_USER_ID=

# DATABASE (PostgreSQL async)
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://legal:legal@db:5432/legal
POSTGRES_USER=legal
POSTGRES_PASSWORD=legal
POSTGRES_DB=legal
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true

# REDIS
REDIS_URL=redis://redis:6379/0

# LLM PROVIDER (OpenAI-Compatible)
# Works with OpenRouter, OpenAI, or any compatible provider
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_DEFAULT_MODEL=qwen/qwen3-6b-plus:free
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# EMBEDDING 
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_TIMEOUT=30

# RERANKER 
RERANKER_BASE_URL=https://openrouter.ai/api/v1/rerank
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_TOP_K=5
RERANKER_MIN_SCORE=0.3
RERANKER_TIMEOUT=30

# Agent Governance
AGENT_MAX_EXECUTOR_LOOPS=3
MAX_EVIDENCE_SLOTS=15

# OCR MODEL (LightOnOCR via HuggingFace)
# Model is downloaded once on first startup and cached at OCR_MODEL_DIR
OCR_MODEL_REPO=lightonai/LightOnOCR-2-1B
OCR_MODEL_DIR=/app/models/ocr
# Optional: HuggingFace token for private repos
HF_TOKEN=

# OBJECT STORAGE (S3-Compatible: MinIO for dev, AWS S3 for prod)
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=legal-docs
STORAGE_USE_SSL=false

# VECTOR STORE (Weaviate)
WEAVIATE_URL=http://weaviate:8080
WEAVIATE_COLLECTION_NAME=DocumentChunk

# GRAPH STORE (Neo4j)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# CHAT HISTORY
# Number of last turns to include in LLM context per request
CHAT_HISTORY_MAX_TURNS=10

# LANGFUSE (Observability)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=http://langfuse:3000
