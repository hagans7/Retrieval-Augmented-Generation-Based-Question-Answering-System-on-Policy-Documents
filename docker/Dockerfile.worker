# ============================================================
# Celery Worker Dockerfile
# Same base as API image, different entrypoint.
# ============================================================
FROM python:3.12-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_SYSTEM_PYTHON=1

RUN pip install uv==0.5.11 --no-cache-dir

WORKDIR /app
COPY pyproject.toml ./
RUN uv pip install --system -e "." --no-cache

FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

COPY --from=builder /usr/local/lib/python3.12 /usr/local/lib/python3.12
COPY --from=builder /usr/local/bin /usr/local/bin

COPY src/ ./src/

RUN groupadd -r legal && useradd -r -g legal legal
RUN mkdir -p /app/models && chown -R legal:legal /app

USER legal

CMD ["celery", "-A", "src.celery_app", "worker", "--loglevel=info", "--concurrency=2"]
